# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=bi_database
POSTGRES_USER=bi_user
POSTGRES_PASSWORD=change_me

# Jira Cloud (use an API token, never your Atlassian password)
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=change_me
JIRA_JQL=ORDER BY updated ASC
JIRA_STORY_POINTS_FIELD=customfield_10016

# Bitrix24 inbound webhook base URL.
# Example shape: https://your-company.bitrix24.com/rest/1/secret
BITRIX24_WEBHOOK_URL=https://your-company.bitrix24.com/rest/1/change_me
